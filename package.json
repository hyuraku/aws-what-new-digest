{
  "name": "aws-whats-new-digest",
  "version": "1.0.0",
  "description": "AWS What's New RSSフィードのAI要約付きアーカイブ",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "collect": "tsx scripts/collect.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": ["aws", "rss", "digest", "ai", "summary"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "openai": "^6.16.0",
    "rss-parser": "^3.13.0",
    "vitepress": "^1.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^25.0.6",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
